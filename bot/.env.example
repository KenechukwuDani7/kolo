# Copy to .env and fill in. Never commit .env.

# AI message reader (Claude Haiku 4.5 on Amazon Bedrock)
AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=us-east-1
KOLO_MODEL=global.anthropic.claude-haiku-4-5-20251001-v1:0

# Roqqu RAS sandbox: the test PRIVATE key (RASPRIV...), sent as x-staging-api-key
ROQQU_BASE=https://service.roqqu.com/v1
ROQQU_TEST_PRIVATE_KEY=

# WhatsApp: only act in these groups (names or ids, comma-separated)
KOLO_GROUPS=Kolo Test
QR_PORT=3117
